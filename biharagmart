    ];

    const productGrid = document.getElementById("productGrid");
    const cartCount = document.getElementById("cartCount");
    const searchInput = document.getElementById("searchInput");

    let cartItems = 0;

    function formatPrice(value) {
      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0
      }).format(value);
    }

    function renderProducts(list) {
      productGrid.innerHTML = list.map(product => `
        <article class="product-card">
          <div class="product-img">
            <img src="${product.image}" alt="${product.name}" loading="lazy">
          </div>
          <div class="product-body">
            <span class="badge">${product.badge}</span>
            <div class="rating">★★★★★ <span style="color:#565959;">(${product.reviews})</span></div>
            <h3 class="product-name">${product.name}</h3>
            <div class="price">
              <span>₹</span><strong>${Math.floor(product.price / 1000)}</strong><small>${(product.price % 1000).toString().padStart(3, '0')}</small>
            </div>
            <div class="prime">${product.prime ? "Prime" : ""}</div>
            <div class="delivery">${product.delivery}</div>
            <button class="cart-btn" data-name="${product.name}">Add to Cart</button>
          </div>
        </article>
      `).join("");
    }

    renderProducts(products);

    document.addEventListener("click", (e) => {
      const btn = e.target.closest(".cart-btn");
      if (!btn) return;

      cartItems += 1;
      cartCount.textContent = cartItems;

      btn.textContent = "Added";
      btn.style.background = "#d8f0d8";
      btn.style.borderColor = "#89cc8a";

      setTimeout(() => {
        btn.textContent = "Add to Cart";
        btn.style.background = "var(--amazon-yellow)";
        btn.style.borderColor = "#f3b21d";
      }, 1000);
    });

    searchInput.addEventListener("input", (e) => {
      const query = e.target.value.trim().toLowerCase();
      const filtered = products.filter(product =>
        product.name.toLowerCase().includes(query) ||
        product.category.toLowerCase().includes(query)
      );
      renderProducts(filtered);
    });

    document.querySelector(".newsletter form").addEventListener("submit", (e) => {
      e.preventDefault();
      alert("Thanks for subscribing! You will receive deals soon.");
