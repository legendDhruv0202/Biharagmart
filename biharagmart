<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amazon Style Store</title>
  <style>
    :root{
      --amazon-blue:#131921;
      --amazon-blue-2:#232f3e;
      --amazon-orange:#febd69;
      --amazon-orange-2:#f3a847;
      --amazon-yellow:#ffd814;
      --text:#0f1111;
      --muted:#565959;
      --light:#f3f3f3;
      --card:#ffffff;
      --green:#007600;
      --border:#d5d9d9;
      --shadow:0 2px 5px rgba(15,17,17,.15);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background:#eaeded;
      color:var(--text);
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    img{
      max-width:100%;
      display:block;
    }

    .container{
      width: min(1400px, 96%);
      margin:0 auto;
    }

    .topbar{
      background:var(--amazon-blue);
      color:white;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      padding:10px 20px;
      position:sticky;
      top:0;
      z-index:100;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:8px;
      min-width:120px;
    }

    .brand-logo{
      font-size:24px;
      font-weight:700;
      letter-spacing:-1px;
    }

    .brand-logo span{
      color:var(--amazon-orange);
    }

    .location{
      display:flex;
      align-items:center;
      gap:6px;
      color:#d6d6d6;
      font-size:12px;
      min-width:110px;
    }

    .location strong{
      display:block;
      font-size:14px;
      color:white;
      margin-top:2px;
    }

    .search-wrap{
      flex:1;
      display:flex;
      align-items:center;
      background:white;
      border-radius:8px;
      overflow:hidden;
      min-width:260px;
    }

    .search-category{
      background:#e6e6e6;
      color:#444;
      padding:12px 14px;
      font-size:14px;
      border:none;
      border-right:1px solid #ccc;
      min-width:110px;
      cursor:pointer;
    }

    .search-wrap input{
      flex:1;
      border:none;
      padding:14px 16px;
      font-size:16px;
      outline:none;
    }

    .search-btn{
      background:var(--amazon-orange);
      border:none;
      font-size:22px;
      padding:12px 18px;
      cursor:pointer;
    }

    .nav-actions{
      display:flex;
      align-items:center;
      gap:14px;
      font-size:12px;
      color:#f1f1f1;
      white-space:nowrap;
    }

    .nav-item{
      display:flex;
      flex-direction:column;
      gap:2px;
      line-height:1.2;
      cursor:pointer;
    }

    .nav-item strong{
      font-size:14px;
      color:white;
    }

    .cart{
      display:flex;
      align-items:center;
      gap:6px;
      font-weight:700;
      font-size:14px;
    }

    .cart-count{
      background:var(--amazon-orange);
      color:var(--text);
      border-radius:50%;
      width:24px;
      height:24px;
      display:grid;
      place-items:center;
      font-size:12px;
      font-weight:700;
    }

    .category-bar{
      background:var(--amazon-blue-2);
      color:white;
      padding:8px 20px;
      display:flex;
      flex-wrap:wrap;
      gap:20px;
      font-size:14px;
    }

    .category-bar a{
      opacity:.9;
    }

    .hero{
      background:linear-gradient(90deg, rgba(8,10,20,.75), rgba(7,10,18,.25)),
                 url('https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      min-height:420px;
      display:flex;
      align-items:flex-end;
      padding:40px 0 20px;
    }

    .hero-box{
      max-width:650px;
      background:rgba(255,255,255,.08);
      color:white;
      border:1px solid rgba(255,255,255,.2);
      backdrop-filter: blur(2px);
      padding:24px 28px;
      border-radius:12px;
      margin-left:40px;
    }

    .hero-box .tag{
      display:inline-block;
      background:var(--amazon-yellow);
      color:#111;
      padding:6px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      letter-spacing:.5px;
      text-transform:uppercase;
      margin-bottom:12px;
    }

    .hero-box h1{
      font-size: clamp(2rem, 4vw, 3.3rem);
      line-height:1.1;
      margin:0 0 12px;
    }

    .hero-box p{
      margin:0 0 20px;
      font-size:1rem;
      color:#f0f0f0;
    }

    .cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      background:var(--amazon-yellow);
      color:#111;
      border:none;
      padding:12px 18px;
      border-radius:999px;
      font-weight:700;
      cursor:pointer;
      box-shadow:var(--shadow);
    }

    .main{
      padding:20px 0 40px;
    }

    .row{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:18px;
      margin-top:18px;
    }

    .panel{
      background:white;
      border:1px solid var(--border);
      border-radius:10px;
      padding:18px;
      box-shadow:var(--shadow);
    }

    .panel h2{
      margin:0 0 16px;
      font-size:22px;
    }

    .mini-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:12px;
      margin-bottom:10px;
    }

    .mini-item{
      background:#f7f7f7;
      border-radius:8px;
      overflow:hidden;
      border:1px solid #ebebeb;
    }

    .mini-item img{
      width:100%;
      height:120px;
      object-fit:cover;
    }

    .mini-item p{
      padding:8px 10px;
      font-size:13px;
      margin:0;
      color:#2b2b2b;
    }

    .link{
      display:inline-block;
      margin-top:12px;
      color:#007185;
      font-size:14px;
    }

    .products{
      display:grid;
      grid-template-columns:repeat(5, 1fr);
      gap:18px;
      margin-top:18px;
    }

    .product-card{
      background:white;
      border:1px solid var(--border);
      border-radius:12px;
      overflow:hidden;
      box-shadow:var(--shadow);
      transition:transform .2s ease, box-shadow .2s ease;
    }

    .product-card:hover{
      transform:translateY(-4px);
      box-shadow:0 6px 16px rgba(0,0,0,.12);
    }

    .product-img{
      height:220px;
      background:#f2f2f2;
      display:flex;
      align-items:center;
      justify-content:center;
      overflow:hidden;
    }

    .product-img img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .product-body{
      padding:14px;
    }

    .badge{
      display:inline-block;
      background:#f6f8f8;
      color:#0f1111;
      border:1px solid #dfe1e1;
      border-radius:999px;
      font-size:11px;
      padding:4px 8px;
      margin-bottom:8px;
      font-weight:700;
    }

    .rating{
      color:#f78f24;
      font-size:14px;
      margin-bottom:8px;
    }

    .product-name{
      font-size:15px;
      line-height:1.4;
      min-height:42px;
      margin:0 0 8px;
    }

    .price{
      font-size:12px;
      color:var(--muted);
      margin-bottom:8px;
    }

    .price strong{
      font-size:26px;
      color:var(--text);
      letter-spacing:-1px;
    }

    .price small{
      font-size:15px;
      vertical-align:top;
    }

    .prime{
      font-size:12px;
      color:#0f9d58;
      font-weight:700;
      margin-bottom:10px;
    }

    .delivery{
      font-size:12px;
      color:var(--muted);
      margin-bottom:14px;
    }

    .cart-btn{
      background:var(--amazon-yellow);
      border:1px solid #f3b21d;
      border-radius:999px;
      width:100%;
      padding:10px 12px;
      font-size:14px;
      font-weight:700;
      cursor:pointer;
      transition:.2s ease;
    }

    .cart-btn:hover{
      background:#f7ca54;
    }

    .deals-banner{
      margin-top:26px;
      background:linear-gradient(90deg, #d5e9f7, #f6f4ef);
      border:1px solid #d5d9d9;
      border-radius:12px;
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:20px 24px;
    }

    .deals-banner h3{
      margin:0 0 4px;
      font-size:28px;
    }

    .deals-banner p{
      margin:0;
      color:var(--muted);
    }

    .deal-btn{
      background:var(--amazon-blue-2);
      color:white;
      border:none;
      border-radius:999px;
      padding:12px 18px;
      font-weight:700;
      cursor:pointer;
    }

    .newsletter{
      margin-top:26px;
      background:linear-gradient(135deg, #fff, #f5f7f7);
      border:1px solid var(--border);
      border-radius:12px;
      padding:26px;
      text-align:center;
    }

    .newsletter h3{
      margin:0 0 8px;
      font-size:28px;
    }

    .newsletter p{
      margin:0 0 16px;
      color:var(--muted);
    }

    .newsletter form{
      display:flex;
      justify-content:center;
      gap:10px;
      flex-wrap:wrap;
    }

    .newsletter input{
      width:min(480px, 90vw);
      padding:14px 16px;
      border:1px solid #c7d0d0;
      border-radius:8px;
      font-size:16px;
    }

    .newsletter button{
      background:var(--amazon-orange);
      border:none;
      border-radius:8px;
      padding:14px 22px;
      font-weight:700;
      cursor:pointer;
    }

    footer{
      background:var(--amazon-blue-2);
      color:#fff;
      margin-top:30px;
      padding:28px 0 40px;
    }

    .footer-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:22px;
    }

    .footer-col h4{
      margin:0 0 12px;
      font-size:16px;
    }

    .footer-col a{
      display:block;
      color:#d7e0e8;
      margin:7px 0;
      font-size:14px;
    }

    .footer-bottom{
      border-top:1px solid rgba(255,255,255,.1);
      margin-top:20px;
      padding-top:20px;
      text-align:center;
      color:#d5d5d5;
      font-size:14px;
    }

    @media (max-width: 1100px){
      .products{
        grid-template-columns:repeat(3,1fr);
      }
      .row{
        grid-template-columns:repeat(2,1fr);
      }
    }

    @media (max-width: 860px){
      .topbar{
        flex-wrap:wrap;
        justify-content:center;
      }
      .nav-actions{
        width:100%;
        justify-content:center;
      }
      .hero-box{
        margin:0 20px 20px;
      }
      .products{
        grid-template-columns:repeat(2,1fr);
      }
      .footer-grid{
        grid-template-columns:repeat(2,1fr);
      }
    }

    @media (max-width: 560px){
      .products, .row, .footer-grid{
        grid-template-columns:1fr;
      }

      .search-wrap{
        width:100%;
      }
      .category-bar{
        justify-content:center;
      }
      .hero{
        min-height:340px;
      }
      .hero-box{
        padding:18px;
      }
      .deals-banner{
        flex-direction:column;
        text-align:center;
        gap:16px;
      }
    }
  </style>
</head>
